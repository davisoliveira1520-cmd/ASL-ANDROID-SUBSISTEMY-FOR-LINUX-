#!/usr/bin/env bash
#
# aslm — Android Subsystem for Linux (WSL-like CLI para Android)
#
# O ASLM é o "WSL do Android": você instala e gerencia distros GNU/Linux
# (Arch, Ubuntu, Debian, Fedora...) por cima do Android, como o WSL faz no
# Windows. Este comando espelha a CLI do wsl.
#
# Uso:
#   aslm                                 → abre o shell da distro padrão
#   aslm <distro> [-- comando]           → abre/executa numa distro
#   aslm -d <distro> <comando>           → executa comando numa distro
#   aslm --list | -l                     → lista distros instaladas
#   aslm --install -d <distro>           → instala uma distro
#   aslm --unregister <distro>           → remove uma distro
#   aslm --set-default <distro>          → define a distro padrão
#   aslm --export <distro> <arquivo.tar> → exporta o rootfs (backup)
#   aslm --import <distro> <arquivo.tar> → importa um rootfs (restaura)
#   aslm --shutdown                      → encerra processos das distros
#   aslm config                          → mostra a configuração atual
#   aslm --version                       → versão
#   aslm --help | -h                     → ajuda
set -euo pipefail

ASLM_VERSION="1.0.0"
PROOT="proot-distro"

SEC='\033[1;32m'; YEL='\033[1;33m'; RED='\033[1;31m'; NC='\033[0m'
say()  { echo -e "${SEC}[aslm]${NC} $*"; }
warn() { echo -e "${YEL}[aslm] aviso:${NC} $*"; }
fail() { echo -e "${RED}[aslm] ERRO:${NC} $*"; exit 1; }

CONFIG_FILE="${ASLM_CONFIG_FILE:-${HOME}/.config/aslm/aslm.conf}"
PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
ROOTFS_PATHS=(
  "${PREFIX}/var/lib/proot-distro/installed-rootfs"
  "${HOME}/.local/share/proot-distro/installed-rootfs"
)

rootfs_dir() {
  local d
  for d in "${ROOTFS_PATHS[@]}"; do [ -d "${d}" ] && { echo "${d}"; return 0; }; done
  mkdir -p "${ROOTFS_PATHS[0]}"
  echo "${ROOTFS_PATHS[0]}"
}

require_proot() { command -v "${PROOT}" >/dev/null 2>&1 || fail "proot-distro nao encontrado. Rode scripts/bootstrap.sh."; }

default_distro() {
  local v=""
  [ -n "${ASLM_DISTRO:-}" ] && v="${ASLM_DISTRO}"
  [ -z "${v}" ] && [ -f "${CONFIG_FILE}" ] && v=$(sed -n 's/^ASLM_DISTRO="\?\([^"]*\)"\?/\1/p' "${CONFIG_FILE}" | head -n1)
  [ -z "${v}" ] && [ -f "$(dirname "${CONFIG_FILE}")/../aslm.conf" ] && v=$(sed -n 's/^ASLM_DISTRO="\?\([^"]*\)"\?/\1/p' "$(dirname "${CONFIG_FILE}")/../aslm.conf" | head -n1)
  [ -z "${v}" ] && v="archlinux"
  echo "${v}"
}

set_default() {
  mkdir -p "$(dirname "${CONFIG_FILE}")"
  : > "${CONFIG_FILE}"
  printf 'ASLM_DISTRO="%s"\n' "$1" >> "${CONFIG_FILE}"
  say "Distro padrão agora é: $1"
}

installed_list() {
  ${PROOT} list --installed 2>/dev/null | sed -n 's/^ *\+ \([^ ]*\).*/\1/p' || true
}

is_installed() {
  installed_list | grep -qx "$1"
}

# ---------------------------------------------------------------------------
run_login() { # <distro> [comando...]
  local d="$1"; shift
  if [ "$#" -eq 0 ]; then
    ${PROOT} login "${d}"
  else
    ${PROOT} login "${d}" -- "$@"
  fi
}

cmd_list() {
  say "Distros instaladas (ASLM):"
  local rows
  rows=$(installed_list)
  if [ -z "${rows}" ]; then
    warn "Nenhuma distro instalada. Use: aslm --install -d ubuntu"
    return 0
  fi
  local def; def=$(default_distro)
  while IFS= read -r d; do
    if [ "${d}" = "${def}" ]; then
      printf '  %-16s (padrão)\n' "${d}"
    else
      printf '  %-16s\n' "${d}"
    fi
  done <<< "${rows}"
}

cmd_install() { # -d <distro>
  require_proot
  [ "$#" -ge 1 ] || fail "use: aslm --install -d <distro>"
  local d="$1"
  if is_installed "${d}"; then say "${d} já está instalada."; else ${PROOT} install "${d}"; fi
  say "Instalada. Entre com: aslm ${d}"
}

cmd_unregister() { # <distro>
  require_proot
  [ "$#" -ge 1 ] || fail "use: aslm --unregister <distro>"
  warn "Removendo ${1} (apaga o rootfs dela)."
  ${PROOT} remove "$1"
}

cmd_export() { # <distro> <arquivo.tar>
  [ "$#" -ge 2 ] || fail "use: aslm --export <distro> <arquivo.tar>"
  local d="$1" out="$2"
  is_installed "${d}" || fail "distro ${d} não instalada."
  say "Exportando ${d} -> ${out}..."
  ( cd "$(rootfs_dir)" && tar -czf "${out}" "${d}" )
  say "Backup criado."
}

cmd_import() { # <distro> <arquivo.tar>
  [ "$#" -ge 2 ] || fail "use: aslm --import <distro> <arquivo.tar>"
  local d="$1" src="$2"
  [ -f "${src}" ] || fail "arquivo não encontrado: ${src}"
  local dir; dir="$(rootfs_dir)"
  mkdir -p "${dir}"
  say "Importando ${src} -> ${d}..."
  mkdir -p "${dir}/${d}"
  tar -xzf "${src}" -C "${dir}/" --strip-components="${STRIP:-0}" 2>/dev/null || \
    tar -xzf "${src}" -C "${dir}/${d}"
  say "Importada. Entre com: aslm ${d}"
}

cmd_shutdown() {
  require_proot
  local rows; rows=$(installed_list)
  [ -n "${rows}" ] || { say "Nada em execução (nenhuma distro instalada)."; return 0; }
  while IFS= read -r d; do
    if [ -d "$(rootfs_dir)/${d}" ]; then
      pkill -f "$(rootfs_dir)/${d}" >/dev/null 2>&1 || true
    fi
  done <<< "${rows}"
  say "Processos das distros encerrados. (proot é stateless — nada a desligar.)"
}

cmd_config() {
  say "Configuração atual:"
  echo "  Distro padrão : $(default_distro)"
  echo "  Config file   : ${CONFIG_FILE}"
  echo "  Rootfs dir    : $(rootfs_dir)"
  [ -f "${CONFIG_FILE}" ] && { echo "  Conteúdo:"; sed 's/^/    /' "${CONFIG_FILE}"; }
}

usage() {
  sed -n 's/^#   /  /p;/^# Uso:/,$p' "$0" 2>/dev/null | sed -n '3,99p'
}

cmd="${1:-}"
case "${cmd}" in
  "" )                        run_login "$(default_distro)" ;;
  --list|-l)                  cmd_list ;;
  --install)                  shift; [ "${1:-}" = "-d" ] && shift || true; cmd_install "$@" ;;
  --unregister|--remove)      shift; cmd_unregister "$@" ;;
  --set-default|--set-default-version) shift; set_default "$1" ;;
  --export)                   shift; cmd_export "$@" ;;
  --import)                   shift; cmd_import "$@" ;;
  --shutdown)                 cmd_shutdown ;;
  --version|-V)               say "aslm ${ASLM_VERSION} (proot-distro)" ;;
  --help|-h)                  usage ;;
  -d|-D)                      shift; [ "$#" -ge 1 ] || fail "use: aslm -d <distro> [comando]"; run_login "$1" "${@:2}" ;;
  config)                     cmd_config ;;
  *)                          if is_installed "${cmd}"; then run_login "${cmd}" "${@:2}"; else fail "distro ou comando desconhecido: ${cmd} (veja: aslm --help)"; fi ;;
esac